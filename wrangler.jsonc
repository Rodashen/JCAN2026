{
  "name": "jcan-exam-access",
  "main": "access/worker.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "SITE_ORIGIN": "https://jcan-exam-access.tararoneee.workers.dev",
    "SENDER_EMAIL": "tararoneee@gmail.com"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "jcan-exam-access",
    "database_id": "ae3b4636-3436-43fb-859d-60907a3dd662"
  }],
  "triggers": { "crons": ["0 0 * * *"] }
}
